# ─── Plaid API Keys ───────────────────────────────────────────────────────────
# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here

# Environment: sandbox | development | production
# Use 'sandbox' for testing (no real bank), 'development' for up to 100 live accounts
PLAID_ENV=sandbox

# Optional only when Plaid OAuth is enabled; must exactly match a Plaid-registered URI
# PLAID_REDIRECT_URI=https://your-app.netlify.app/

# ─── App ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (your Netlify domain)
ALLOWED_ORIGINS=https://your-app.netlify.app,http://localhost:5173

# Stable identifier for this household's shared records
BREVITY_HOUSEHOLD_ID=lslj-family
# Secret used only by Netlify Scheduled Functions (generate a long random value)
BREVITY_AUTOMATION_KEY=replace_with_a_long_random_secret
# IANA timezone used for timed Apple Calendar events
BREVITY_TIME_ZONE=America/New_York

# ─── Netlify Blobs ────────────────────────────────────────────────────────────
# Required for local netlify dev. Netlify supplies site context in production.
NETLIFY_SITE_ID=your_netlify_site_id
NETLIFY_TOKEN=your_netlify_personal_access_token

# ─── Apple/iCloud Calendar ────────────────────────────────────────────────────
ICLOUD_EMAIL=your_apple_id_email
ICLOUD_APP_PASSWORD=your_apple_app_specific_password
ICLOUD_CALENDAR_NAME=Family

# ─── Brevity AI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_server_side_openai_api_key
# Optional model override
BREVITY_AI_MODEL=gpt-5.6
